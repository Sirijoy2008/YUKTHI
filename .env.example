# YUKTHI Environment Variables (Placeholders only)

# Server Config
PORT=3000
NODE_ENV=development

# Supabase Project Configuration (Placeholders only)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="your-server-side-service-role-key-placeholder"

# Database Configuration (Supabase PostgreSQL via Prisma)
# Pooled connection string (Transaction mode, port 6543) for application queries:
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"

# Direct connection string (Direct session mode, port 5432) for migrations:
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?schema=public"

# Optional Authorized Identity Verification Provider (UIDAI Sub-AUA / DigiLocker Gateway)
# If unconfigured, the application runs in sandbox prototype mode and safely bypasses live KYC
UIDAI_SUB_AUA_CODE="your-sub-aua-code-placeholder"
UIDAI_ASA_API_KEY="your-asa-api-key-placeholder"
DIGILOCKER_CLIENT_ID="your-digilocker-client-id-placeholder"
DIGILOCKER_CLIENT_SECRET="your-digilocker-client-secret-placeholder"

